# Bytebank — variáveis consumidas pelo docker-compose.yml da raiz.
# Copie para `.env` (gitignored): o Docker Compose carrega esse arquivo
# automaticamente para as substituições ${...} do compose.
#
#   cp .env.example .env
#
# (Para rodar o shell em dev fora do compose, use apps/shell/.env.local —
#  veja apps/shell/.env.example, que documenta as vars da aplicação.)

# --- Autenticação (NextAuth v5, lido pelo serviço `shell`) ---
# Segredo de assinatura dos JWTs. Gere um por ambiente com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se ficar vazio, o compose usa o fallback `dev-secret` (só para smoke local).
AUTH_SECRET=

# CSP do shell: mantenha report-only até revisar os relatórios e depois use enforce.
CSP_MODE=report-only

# Cloudflare Turnstile (opcional; CAPTCHA após 3 falhas de login)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting de login/cadastro (valores padrão; duração em segundos)
AUTH_MAX_FAILURES=5
AUTH_WINDOW_SECONDS=900
AUTH_LOCK_SECONDS=900
AUTH_MAX_LOCK_SECONDS=86400
AUTH_IP_MAX_FAILURES=20
AUTH_IP_WINDOW_SECONDS=900
AUTH_IP_LOCK_SECONDS=900
AUTH_REGISTER_IP_MAX_FAILURES=10
AUTH_REGISTER_IP_WINDOW_SECONDS=3600
AUTH_REGISTER_IP_LOCK_SECONDS=3600

# --- Cifra dos anexos (AES-256-GCM): id:base64 de 32 bytes; vazio usa a chave de smoke do compose ---
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY_ID=

# --- Blind index do e-mail (HMAC-SHA256): base64 de 32 bytes, diferente da chave de cifra; vazio usa a chave de smoke do compose ---
BLIND_INDEX_KEY=

# --- Upload de anexos (Vercel Blob — opcional) ---
# Token read/write gerado em Vercel > Storage > Blob > Tokens.
# Vazio: o upload de anexos falha graciosamente (storage mock). Ok para o smoke básico.
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Primeiro boot (clone limpo) — migrate + seed rodam FORA do compose:
#
#   docker compose up -d db                 # sobe só o Postgres
#   npm run db:migrate -w @bytebank/shell   # cria as tabelas (transactions, attachments, users)
#   npm run db:seed -w @bytebank/shell      # carrega data/transactions.json
#   docker compose up --build               # sobe shell + dashboard-mfe + transactions-mfe
#
# Login: crie uma conta em http://localhost:3000/register e faça login com ela.
# -----------------------------------------------------------------------------
